{
  // Respostas no chat para !setnav and !hudscale, cada uma enviada após customhud.prefix.
  // [green] and [default] are SwiftlyS2 chat colour tags.
  "customhud.prefix": "[green][CustomHUD][default]",
  "customhud.nav.usage": "Uso: !setnav wasd | buttons | numbers | mouse (atual: {0})",
  "customhud.nav.set": "Navegação definida para [green]{0}[default].",
  "customhud.scale.usage": "Uso: !hudscale {0}",
  "customhud.scale.set": "Escala do menu definida para [green]{0}%[default].",

  // !ch_test. Seus exemplos, .center and .alert, são exibidos pelo HUD: texto simples, sem tags de cor.
  // {0} is the Messages setting (Center or Alert), {1} o nome que contém.
  "customhud.test.usage": "Uso: !ch_test center | alert [texto]",
  "customhud.test.center": "Teste do CustomHUD: mensagem central",
  "customhud.test.alert": "Teste do CustomHUD: alerta",
  "customhud.test.layout": "Messages.{0} está definido como [green]{1}[default], então o CustomHUD o exibe.",
  "customhud.test.game": "Messages.{0} está definido como [green]game[default], então o próprio jogo o exibe.",
  "customhud.test.unknown": "Messages.{0} \"{1}\" não corresponde a nenhum layout, então o próprio jogo o exibe.",

  // Menu footer per nav mode; ".view" is a menu with nothing to selecionar. {up} {down}
  // {selecionar} {fechar} name the menu's keys. A "Hints" entry in config.jsonc overrides
  // a key in every language. The footer is one uppercase line, so keep them short.
  "customhud.hint.wasd": "W/S MOVER · E SELECIONAR · R FECHAR",
  "customhud.hint.buttons": "{up}/{down} MOVER · {select} SELECIONAR · {close} FECHAR",
  "customhud.hint.numbers": "1-6 SELECIONAR · 7/8 PÁGINA · 9 FECHAR",
  "customhud.hint.mouse": "Clique para SELECIONAR",
  "customhud.hint.chat": "!N SELECIONAR · !0 FECHAR",
  "customhud.hint.wasd.view": "R FECHAR",
  "customhud.hint.buttons.view": "{close} FECHAR",
  "customhud.hint.numbers.view": "9 FECHAR",
  "customhud.hint.mouse.view": "Clique em {close} para FECHAR",
  "customhud.hint.chat.view": "!0 FECHAR",

  // Identificadores de página (menu_locker): a linha dourada acima do título de um plugin when its menu
  // has no root title of its own, and a etiqueta na linha que recebeu mais votos.
  // Os menus de qualquer plugin também podem ter essa linha: add "customhud.eyebrow.<plugin>", where <plugin>
  // is the first part of its menu ids ("missions" for missions.main; DetailedLogging names
  // them), or "customhud.eyebrow.default" for every plugin without one. "" shows no line.
  // Nenhum deles vem incluído, so a key added here reaches players in every language.
  "customhud.eyebrow.shop": "Loja",
  "customhud.eyebrow.maps": "Votação de Mapa",
  "customhud.eyebrow.ranks": "Classificações",
  "customhud.eyebrow.vip": "VIP",
  "customhud.eyebrow.admins": "Admin",
  "customhud.eyebrow.mix": "Mix",
  "customhud.lead": "Na liderança",

  // O rodapé da lista (menu_list): the word beside each key. Exibida em maiúsculas.
  "customhud.legend.move": "Mover",
  "customhud.legend.select": "Selecionar",
  "customhud.legend.pick": "Escolher",
  "customhud.legend.open": "Abrir",
  "customhud.legend.switch": "Alternar",
  "customhud.legend.edit": "Editar",
  "customhud.legend.change": "Alterar",
  "customhud.legend.vote": "Votar",
  "customhud.legend.apply": "Aplicar",
  "customhud.legend.page": "Página",
  "customhud.legend.back": "Voltar",
  "customhud.legend.close": "Fechar",

  // ---- Páginas dos provedores --------------------------------------------------------------------------
  //
  // Legendas adicionadas pelo CustomHUD when it draws another plugin's menus from that plugin's API (Ranks and
